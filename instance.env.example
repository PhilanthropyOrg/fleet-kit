# instance.env -- the facts about ONE install that change: which box, which paths, which
# container, which URL. Docs (README.md, RUNBOOK.md) hold what stays true and use these names;
# this file holds what changes. People and code read the same file.
#
# Copy to instances/<name>/instance.env (git-ignored) on the box AND next to your laptop
# checkout, then fill in. It is plain shell: one NAME=value per line, no spaces around "=".
#
#   . instances/<name>/instance.env          # load it into your shell (RUNBOOK starts here)
#   bash scripts/fleet_status.sh --where     # show what the status script resolved from it
#
# NO SECRETS HERE. Tokens and keys live in ~/.config/fleet-kit/secrets.env and in the
# instance's fleet.env. The dials the fleet reads on every run (kill switch, accounts, budgets)
# also stay in fleet.env; this file is only "where is it".
#
# Read by: scripts/fleet_status.sh (when exactly one instances/*/instance.env exists, or
# FLEET_INSTANCE_ENV points at one). A value set in the environment still wins.

# The name you ssh to (an ssh_config Host alias or a hostname).
FLEET_BOX=box.example.com
# The fleet-kit checkout on the box.
FLEET_BOX_KIT_DIR=/srv/fleet-kit
# This instance's state dir on the box: fleet.env, logs/, repo/.
FLEET_BOX_INSTANCE_DIR=/srv/fleet-kit/instances/myproduct
# The podman container name (up.sh default: fleet-kit-<name>).
FLEET_BOX_CONTAINER=fleet-kit-myproduct
# Where auto_deploy.sh writes "deploy OK at <sha>" on the box.
FLEET_BOX_DEPLOY_LOG=/srv/fleet-kit/instances/myproduct/logs/auto_deploy.log
# The public address of the fleet console (blank if it is not exposed).
FLEET_BOX_URL=https://fleet.example.com
