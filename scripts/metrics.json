{
 "_doc": "fk#1058: the metric registry. Every console tile is a row here; the OKR file references tiles by id. A KR that names an id not in this file fails a selftest. Order = display order. gh#8212: one tile per quantity, each with as_of + cadence_s from /api/metrics. fk#1393: `home` groups Home's tiles into sections (outcome/output/flow/health); `hidden` still computes and is still read by id (scoreboard/OKR/tests) but is folded into another tile's body on Home instead of shown on its own.",
 "metrics": [
  {
   "id": "fleet.issues_resolved_24h",
   "label": "Issues resolved",
   "unit": "issues",
   "window": "24h; line = per day, 14d",
   "source": "scoreboard.resolved_events: merged PR closes an issue COMPLETED, carried live by a later successful FLEET_DEPLOY_WORKFLOW run",
   "lane": "fleet",
   "history": "native",
   "home": "output"
  },
  {
   "id": "fleet.reif_priority_throughput_6h",
   "label": "Reif-priority throughput",
   "unit": "issues/hr",
   "window": "6h rolling avg",
   "source": "scoreboard.resolved_events filtered to fleet:reif-priority, merged PR + deployed (philanthropy#8197)",
   "lane": "fleet",
   "history": "none",
   "home": "output"
  },
  {
   "id": "okr.verified_claims",
   "label": "The number",
   "unit": "claims",
   "window": "14 days",
   "source": "number_read (FLEET_NUMBER_URL)",
   "lane": "product",
   "history": "daily",
   "home": "outcome"
  },
  {
   "id": "okr.clicks",
   "label": "Claims started",
   "unit": "claims/wk",
   "window": "14 days",
   "source": "number_read kr1.value (FLEET_NUMBER_URL)",
   "lane": "product",
   "history": "daily",
   "home": "outcome"
