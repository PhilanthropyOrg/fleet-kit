{
 "_doc": "fk#1058: the metric registry. Every console tile is a row here; the OKR file references tiles by id. A KR that names an id not in this file fails a selftest. Order = display order.",
 "metrics": [
  {
   "id": "okr.verified_claims",
   "label": "The number",
   "unit": "claims",
   "window": "14 days",
   "source": "number_read (FLEET_NUMBER_URL)",
   "lane": "product",
   "history": "daily"
  },
  {
   "id": "okr.clicks",
   "label": "Claims started",
   "unit": "claims/wk",
   "window": "14 days",
   "source": "number_read kr1.value (FLEET_NUMBER_URL)",
   "lane": "product",
   "history": "daily"
  },
  {
   "id": "okr.conversion",
   "label": "Claim completion",
   "unit": "%",
   "window": "14 days",
   "source": "number_read kr1.completion_rate_pct",
   "lane": "product",
   "history": "daily"
  },
  {
   "id": "fleet.backlog_open",
   "label": "Backlog",
   "unit": "issues",
   "window": "14 days",
   "source": "gh issue list --label fleet:backlog",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.prs_open",
   "label": "Open PRs",
   "unit": "PRs",
   "window": "14 days",
   "source": "gh pr list --state open",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.merged_per_day",
   "label": "Merged",
   "unit": "PRs",
   "window": "per day, 14d",
   "source": "gh pr list --state merged",
   "lane": "fleet",
   "history": "native"
  },
  {
   "id": "fleet.items_per_minion_run",
   "label": "Items / run",
   "unit": "items",
   "window": "median, 24h",
   "source": "runs.jsonl minion item_id (target FLEET_MINION_TARGET_ITEMS)",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.closed_per_minion_run",
   "label": "Closed / run",
   "unit": "issues",
   "window": "24h",
   "source": "merged member/minion-* PRs' closingIssuesReferences / executed minion runs",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.shipped_live_per_day",
   "label": "Shipped live",
   "unit": "PRs",
   "window": "per day, 14d",
   "source": "merged PRs carried by a later successful FLEET_DEPLOY_WORKFLOW run",
   "lane": "fleet",
   "history": "native"
  },
  {
   "id": "fleet.backlog_trend",
   "label": "Backlog trend",
   "unit": "issues/7d",
   "window": "7 days",
   "source": "fleet.backlog_open daily history",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.issues_resolved_per_hour",
   "label": "Issues resolved / hr",
   "unit": "issues/hr",
   "window": "24h avg",
   "source": "issues_per_hour.py: merged PR closes it AND deployed, mega-credit aware",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "gh.actions_spend_mtd",
   "label": "GitHub Actions",
   "unit": "USD",
   "window": "month to date",
   "source": "gh api /orgs/{org}/settings/billing/usage",
   "lane": "fleet",
   "history": "native"
  },
  {
   "id": "fleet.accounts_live",
   "label": "Claude accounts",
   "unit": "live",
   "window": "14 days",
   "source": "account-pool-exhausted.state vs FLEET_ACCOUNTS",
   "lane": "fleet",
   "history": "daily"
  },
  {
   "id": "fleet.ok_runs_per_hour",
   "label": "Alive",
   "unit": "ok runs",
   "window": "per hour, 24h",
   "source": "runs.jsonl",
   "lane": "fleet",
   "history": "native"
  },
  {
   "id": "fleet.minion_spawns_per_hour",
   "label": "Spawns (minion)",
   "unit": "passes",
   "window": "per hour, 24h",
   "source": "runs.jsonl",
   "lane": "fleet",
   "history": "native"
  },
  {
   "id": "fleet.prs_opened_per_hour",
   "label": "PRs opened",
   "unit": "PRs",
   "window": "per hour, 24h",
   "source": "gh pr list head:member/",
   "lane": "fleet",
   "history": "native"
  }
 ]
}
